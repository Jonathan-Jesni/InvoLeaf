__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# Downloaded datasets. Anchored with a leading slash so these match ONLY the
# repository root - a bare `data/` also matches involeaf/data/ and would silently
# exclude the data module from the repository.
/data/
/datasets/
*.pth
*.pt
*.ckpt
# Result JSONs ARE committed: three people train on three separate cloud instances
# and merging those files is the only way make_tables.py can see every run. They are
# small and text. Checkpoints (~350MB each), logs, and generated tables stay out.
results/*
!results/.gitkeep
!results/*.json
# Interpretability arrays (Grad-CAM, kernel maps, ~2 MB) from analyze_mechanism.py.
!results/interp_*.npz
# Results replaced by a corrected rerun, kept for the record. make_tables.py only reads
# results/*.json, so nothing in here reaches a table.
!results/superseded/
runs/
wandb/
*.log

# splits/ is intentionally NOT ignored - fixed splits are committed
.pytest_cache/
